# Copy to .env, set your own disposable development password, then export it.
# Spring Boot does not automatically read this file.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/nexus_local
DB_USERNAME=nexus_local
DB_PASSWORD=
POSTGRES_PORT=5433
# Tests need a separate database; see README. No local fallback is provided.
TEST_DB_URL=jdbc:postgresql://localhost:5433/nexus_test
TEST_DB_USERNAME=nexus_local
TEST_DB_PASSWORD=
