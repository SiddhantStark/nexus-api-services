# Copy to .env and set three different random local-only passwords.
# Spring Boot does not automatically read this file; export it or use IDE env vars.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/nexus_local
DB_USERNAME=nexus_runtime
DB_PASSWORD=
MIGRATION_DB_USERNAME=nexus_migrator
MIGRATION_DB_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PORT=5433
# To opt in to synthetic disabled accounts and catalog fixtures:
# SPRING_PROFILES_ACTIVE=local,local-seed
# Integration tests use disposable Testcontainers; no TEST_DB_* variables needed.
